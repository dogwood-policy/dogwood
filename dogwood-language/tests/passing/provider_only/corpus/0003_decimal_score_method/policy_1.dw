// Permit Read only when the content-risk score is below 0.5, as decided
// by the `Content::Risk` information provider (implemented in risk.rhai).
// The output is a Cedar decimal, so the comparison uses the decimal
// extension method `.lessThan(decimal("..."))` rather than `<`.

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when guardrails {
    Content::Risk(context.input.document).severityScore.lessThan(decimal("0.5"))
};
