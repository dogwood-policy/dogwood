// Permit Read only when the document matches an allowed-name pattern
// AND is not on the blocklist. Two information providers combined with
// the boolean spine (`&&`, `!`) inside one `guardrails { … }` clause.

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when guardrails {
    Strings::Matches(context.input.document, "^[a-z]+$").matched == true
    && !(Lists::Blocked(context.input.document).blocked == true)
};
