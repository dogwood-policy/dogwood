// Permit Read only when the document's VIOLENCE severity is below 0.5,
// as decided by the `Content::Filter` provider. This mirrors the reference
// guardrail flagship shape: a SET argument (`["VIOLENCE", "HATE"]`), an
// INDEX projection into the output record (`["VIOLENCE"]`) followed by a
// field access (`.severityScore`), and a Cedar decimal extension-method
// comparison (`.lessThan(decimal("0.5"))`).

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when guardrails {
    Content::Filter(context.input.document, ["VIOLENCE", "HATE"])["VIOLENCE"].severityScore.lessThan(decimal("0.5"))
};
