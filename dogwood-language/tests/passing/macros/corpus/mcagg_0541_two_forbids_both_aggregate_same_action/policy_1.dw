def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

forbid (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where (Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: _ } && tp(t)), n >= 2)};
forbid (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let_(s, sum a for (a: Long). where Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a }, s > 200)};
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
