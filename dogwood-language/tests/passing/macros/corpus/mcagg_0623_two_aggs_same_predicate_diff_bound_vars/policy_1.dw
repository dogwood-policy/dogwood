def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    (let_(total, sum a for (a: Long). where Drupe::Action::"Transfer"::request{ input.user: _, input.amount: a }, total == 0)) && (let_(cnt, count for (t: Timepoint). where (Drupe::Action::"Transfer"::request{ input.user: _, input.amount: _ } && tp(t)), cnt == 0))};
