// Macro-form rewrite of 0179_agg_with_once_counts_history.
//
// `count_formerly(W, S)` (W a bare interval, e.g. `1h`) desugars to
// `count for ($t: Timepoint). where (formerly within W (S && tp($t)))`. The expander
// gensyms `$t` per call site, so reusing this macro in two policies is
// hygienic.
//
// Original (hand-explicit) form:
//   let n = count for (t: Timepoint). where
//     (formerly within 1h (Drupe::Action::"Login"{user: _, server: context.input.server}
//                          && tp(t))) in n > 0
// The expected verdicts here are identical to the original case's.

def temporal count_formerly(?w, ?s) {
    count for ($t: Timepoint). where (formerly within ?w (?s && tp($t)))
};

permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    exists (n: Long). ((count_formerly(1h, Drupe::Action::"Login"::request{ input.user: _, input.server: context.input.server })) == n && n > 0)};
