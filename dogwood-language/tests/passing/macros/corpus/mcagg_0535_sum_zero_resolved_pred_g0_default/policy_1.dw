def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

forbid (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let_(total, sum a for (a: Long). where Drupe::Action::"Transfer"::response{ input.user: _, input.amount: a }, total == 0)};
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
