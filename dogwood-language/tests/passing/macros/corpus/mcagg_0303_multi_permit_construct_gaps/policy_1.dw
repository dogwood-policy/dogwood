def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Heartbeat",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where (formerly within 1h (Drupe::Action::"Login"::request{ input.user: context.input.user, input.server: _ } && tp(t))), n > 0)};
