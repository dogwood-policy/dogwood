def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

forbid (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where (formerly within 1h (Drupe::Action::"Login"::request{ input.user: _, input.server: context.input.server } && tp(t))), n > 0)};
permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    let_(total, sum a for (a: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::request{ input.user: _, input.amount: a } && tp(t))), total == 0)};
