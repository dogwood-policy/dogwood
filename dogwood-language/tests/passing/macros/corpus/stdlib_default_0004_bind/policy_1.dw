// Confirms `bind` is loaded from the DEFAULT macro library.
//
// This case ships NO `macros.dw`, so the harness omits `macros_str` and the
// ServiceSchema falls back to `DEFAULT_MACROS`. The policy calls `bind` without
// declaring it anywhere, so it can only parse and replay correctly if the
// built-in stdlib supplies that macro by default. Verdict-equivalent to
// `stdlib_0005_bind_hand_written_agg`, which loads the same macro explicitly via
// its own `macros.dw`. `bind` names the `exists (n: Long). ((agg) == n && …)`
// scaffold; here it wraps a RAW, hand-written `count for …` aggregate. Permit an
// Alert when more than two Logins to the same server occurred within the last
// hour.

permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    bind(
        n,
        count for (t: Timepoint). where (
            formerly within 1h (Drupe::Action::"Login"::request{ input.user: _, input.server: context.input.server } && tp(t))
        ),
        n > 2
    )
};
