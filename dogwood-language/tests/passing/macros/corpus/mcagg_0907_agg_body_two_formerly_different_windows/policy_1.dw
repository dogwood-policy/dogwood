def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Transfer",
    resource
)
when temporal {
    let_(n, count for (t1: Timepoint), (t2: Timepoint). where ((formerly within 10m (Drupe::Action::"Transfer"::request{ input.user: context.input.user } && tp(t1))) && (formerly within 1h (Drupe::Action::"Transfer"::request{ input.user: context.input.user } && tp(t2)))), n >= 2)};
