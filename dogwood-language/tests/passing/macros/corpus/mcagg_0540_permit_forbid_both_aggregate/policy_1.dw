def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where (Drupe::Action::"Login"::request{ input.user: context.input.user } && tp(t)), n == 0)};
forbid (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let_(total, sum a for (a: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::response{ input.user: context.input.user, input.amount: a } && tp(t))), total > 50)};
