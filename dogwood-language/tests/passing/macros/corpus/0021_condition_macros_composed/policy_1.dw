// Two condition macros composed with `&&` inside one temporal block.
// Exercises ConditionKind::Call resolution at multiple call sites
// within a single condition tree, and the hygienic gensym path: each
// call mints its own gensym(s) (currently neither macro introduces
// `!t`, but the registry+walker traverses both calls).
//
// Macro-form rewrite of 0079_two_temporal_when.

def temporal recently_logged_in(?u) {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: ?u }
};

def temporal recently_read(?u, ?d) {
    formerly within 1h Drupe::Action::"Read"::request{ input.user: ?u, input.document: ?d }
};

permit (
    principal,
    action == Drupe::Action::"Write",
    resource
)
when temporal {
    recently_logged_in(context.input.user) && recently_read(context.input.user, context.input.document)
};
