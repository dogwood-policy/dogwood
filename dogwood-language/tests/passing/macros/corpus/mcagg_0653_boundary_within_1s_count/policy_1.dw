def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where ((Drupe::Action::"Heartbeat"::request{ input.server: context.input.server } since within 1 s Drupe::Action::"Login"::request{ input.server: context.input.server, input.user: _ }) && tp(t)), n > 0)};
