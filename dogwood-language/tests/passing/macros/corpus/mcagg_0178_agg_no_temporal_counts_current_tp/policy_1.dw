// Fires iff there is at least one Login at the CURRENT tp with the
// same server as the Alert. Without a temporal wrapper on the body,
// the aggregation sees only same-tp events.
def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};


permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where (Drupe::Action::"Login"::request{ input.user: _, input.server: context.input.server } && tp(t)), n > 0)};
