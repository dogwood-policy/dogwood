def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Transfer",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where ((!(Drupe::Action::"Logout"::request{ input.user: context.input.user }) since within 1h Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: _ }) && tp(t)), n >= 1)};
