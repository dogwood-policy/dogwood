def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let_(n, count for (t: Timepoint). where (formerly within 1h (Drupe::Action::"Login"::response{ input.user: context.input.user, output.result: true } && tp(t))), n > 1)&& let_(total, sum r for (r: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::response{ input.user: context.input.user, output.result: r } && tp(t))), total > 100)};
