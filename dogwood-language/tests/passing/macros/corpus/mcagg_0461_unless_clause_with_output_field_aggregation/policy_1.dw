def temporal let_(?n, ?A, ?B) {
    exists (?n: Long). (?A == ?n && ?B)
};

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
unless temporal {
    let_(total, sum r for (r: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Compute"::response{ input.user: context.input.user, output.result: r } && tp(t))), total > 1000)};
