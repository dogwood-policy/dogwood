entity a;

action "" in [Action::":~", Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}w", Action::"$", Action::"=\u{e}", Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}\u{1d}w" in [Action::"$", Action::"=\u{e}", Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"];

action "\u{e}" in [Action::"[", Action::"\u{3}\u{1d}w", Action::"$", Action::"=\u{e}", Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"];

action "\u{1d}\u{3}";

action "\u{1d}@" in [Action::"^", Action::"\u{1d}\u{3}"];

action "$" in [Action::"=\u{e}", Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"];

action ":~" in [Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}w", Action::"$", Action::"=\u{e}", Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"];

action "=\u{e}" in [Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"];

action "[" in [Action::"\u{3}\u{1d}w", Action::"$", Action::"=\u{e}", Action::"\u{1d}@", Action::"^", Action::"\u{1d}\u{3}"];

action "^" in [Action::"\u{1d}\u{3}"];

