entity a;

action "" in [Action::"z~", Action::"[", Action::"z~\u{3}.\u{1d}@"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}" in [Action::"\u{14}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{14}" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "$" in [Action::"\u{14}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "N~" in [Action::"\u{e}", Action::"[", Action::"z~\u{3}.\u{1d}@", Action::"$"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "[" in [Action::"$"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "z~" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "z~\u{3}.\u{1d}@" in [Action::"\u{14}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

