entity a;

action "" in [Action::":", Action::"\u{e}", Action::"[@\u{16}V", Action::"\u{1d}", Action::"e/", Action::"$"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}" in [Action::"[@\u{16}V", Action::"\u{1d}", Action::"e/", Action::"$"];

action "\u{1d}" in [Action::"e/", Action::"$"];

action "$";

action ":" in [Action::"\u{e}", Action::"[@\u{16}V", Action::"\u{1d}", Action::"e/", Action::"$"];

action "[@\u{16}V" in [Action::"\u{1d}", Action::"e/", Action::"$"];

action "e/" in [Action::"$"];

