entity a;

@r
action "" in [Action::":", Action::"Debian \u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::":p", Action::"%[\u{1d}", Action::"V@", Action::"\u{1b}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}\u{1d}@" in [Action::":p", Action::"%[\u{1d}", Action::"V@", Action::"\u{1b}"];

action "\u{1b}";

action "%[\u{1d}" in [Action::"V@", Action::"\u{1b}"];

action ":" in [Action::"Debian \u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::":p", Action::"%[\u{1d}", Action::"V@", Action::"\u{1b}"];

action ":p" in [Action::"%[\u{1d}", Action::"V@", Action::"\u{1b}"];

action "Debian \u{e}" in [Action::"[", Action::"\u{3}\u{1d}@", Action::":p", Action::"%[\u{1d}", Action::"V@", Action::"\u{1b}"];

action "V@" in [Action::"\u{1b}"];

action "[" in [Action::"\u{3}\u{1d}@", Action::":p", Action::"%[\u{1d}", Action::"V@", Action::"\u{1b}"];

