entity a;

action "" in [Action::"\u{1d}", Action::"V@\u{5}", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}";

action "\u{1d}" in [Action::"V@\u{5}", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":p" in [Action::"", Action::"\u{1d}", Action::"V@\u{5}", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V@\u{5}" in [Action::"\u{e}"];

