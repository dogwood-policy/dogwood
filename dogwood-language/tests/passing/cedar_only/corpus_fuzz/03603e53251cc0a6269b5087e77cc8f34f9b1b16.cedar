permit(
  principal == a::"",
  action in [Action::"action"],
  resource
) when {
  true && ((if (a::"" == a::"") then (if true then [{"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": resource}, {"": principal, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": resource, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": principal}] else []) else [{"": action, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": action, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": resource}]).isEmpty())
};
