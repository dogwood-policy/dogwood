permit(
  principal == a::"",
  action in [Action::"action"],
  resource
) when {
  true && ((if true then (if true then [{"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}": action, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": resource}] else [{"": action, "\u{7}\u{7}\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": resource}, {"": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}": principal, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": action}]) else [{"": action, "\u{7}\u{7}\u{7}\u{7}\u{7}": resource, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": principal}, {"": principal, "\u{7}\u{7}\u{7}\u{7}\u{7}": principal, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": principal}]).isEmpty())
};
