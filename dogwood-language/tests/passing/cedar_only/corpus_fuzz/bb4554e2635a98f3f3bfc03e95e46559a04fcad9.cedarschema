entity a;

action "" in [Action::":", Action::"\u{e}[\u{1d}", Action::"\u{3}", Action::"V@", Action::"V]", Action::"e:"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}" in [Action::"V@", Action::"V]", Action::"e:"];

action "\u{e}[\u{1d}" in [Action::"\u{3}", Action::"V@", Action::"V]", Action::"e:"];

action ":" in [Action::"\u{e}[\u{1d}", Action::"\u{3}", Action::"V@", Action::"V]", Action::"e:"];

action "V@" in [Action::"V]", Action::"e:"];

action "V]" in [Action::"e:"];

action "e:";

