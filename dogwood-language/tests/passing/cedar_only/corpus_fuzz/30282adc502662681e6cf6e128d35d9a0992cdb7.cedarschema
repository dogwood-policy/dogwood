entity a;

action "" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":;" in [Action::"[\u{1d}", Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V" appliesTo {
  principal: [a],
  resource: [a],
  context: {
    A?: __cedar::String
  }
};

action "[\u{1d}" in [Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

