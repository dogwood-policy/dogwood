forbid(
  principal,
  action in [Action::"action"],
  resource
) when {
  ((true && ((decimal(if false then ":e\u{10}" else ":e\u{10}")).greaterThanOrEqual({":e\u{10}": decimal("922337203685477.5807")}[":e\u{10}"]))) && (if (if ((ip("4444:ff00::ff33:67fe:feff")).isIpv6()) then false else false) then false else false)) && false
};
