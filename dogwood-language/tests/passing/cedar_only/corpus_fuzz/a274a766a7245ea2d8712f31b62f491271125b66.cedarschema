entity a tags __cedar::String;

action "" in [Action::":~", Action::"\u{3}\u{1d}[\u{1d}@w", Action::"$", Action::"=\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{1}\u{f}" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}\u{1d}[\u{1d}@w" in [Action::"\u{3}dddddddddd.", Action::"\u{1}\u{f}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}dddddddddd." appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{1d}\u{3}" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "$" in [Action::"\u{1d}\u{3}", Action::"[", Action::"\u{3}dddddddddd.", Action::"\u{1}\u{f}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "$=\u{e}" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":~" in [Action::"$", Action::"$=\u{e}", Action::"\u{1}\u{f}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "=\u{e}" in [Action::"\u{1d}\u{3}", Action::"$=\u{e}", Action::"\u{3}dddddddddd."] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "@" in [Action::"$=\u{e}", Action::"[", Action::"\u{3}dddddddddd.", Action::"\u{1}\u{f}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
