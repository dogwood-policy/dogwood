entity a;

action "" in [Action::":", Action::"\u{e}", Action::"ir", Action::"d", Action::"dpa[", Action::"[", Action::"q"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}" in [Action::"ir", Action::"d", Action::"dpa[", Action::"[", Action::"q"];

action ":" in [Action::"\u{e}", Action::"ir", Action::"d", Action::"dpa[", Action::"[", Action::"q"];

action "[" in [Action::"q"];

action "d" in [Action::"dpa[", Action::"[", Action::"q"];

action "dpa[" in [Action::"[", Action::"q"];

action "ir" in [Action::"d", Action::"dpa[", Action::"[", Action::"q"];

action "q";

