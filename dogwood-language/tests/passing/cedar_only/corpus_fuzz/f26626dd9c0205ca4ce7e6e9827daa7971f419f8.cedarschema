entity a tags __cedar::String;

action "" in [Action::":~", Action::"\u{1d}@[", Action::"\u{3}\u{1d}w", Action::"$"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}\u{1d}w" in [Action::"\u{1d}\u{3}", Action::"$=\u{e}", Action::"[", Action::"\u{3}ddddd"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}ddddd" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{1d}\u{3}" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{1d}@[" in [Action::"["] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "$" in [Action::"[", Action::"\u{3}ddddd"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "$=\u{e}" in [Action::"[", Action::"\u{3}ddddd"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":~" in [Action::"\u{3}\u{1d}w", Action::"@", Action::"\u{3}ddddd"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "=\u{e}" in [Action::"\u{1d}\u{3}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "@" in [Action::"[", Action::"\u{3}ddddd"] appliesTo {
