entity a;

@L3
@m("[\u{1d}")
action "" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}[" in [Action::"V@"];

action "\u{1d}" in [Action::"&", Action::"p", Action::"V@", Action::""] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "&" in [Action::"p", Action::"\u{3}[", Action::"V@", Action::""] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V@";

action "p";

