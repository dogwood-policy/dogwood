entity a;

action "" in [Action::":p", Action::"&", Action::"\u{1d}", Action::"+wV@$", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}";

action "\u{1d}" in [Action::"+wV@$", Action::"\u{e}"];

action "&" in [Action::"\u{1d}", Action::"+wV@$", Action::"\u{e}"];

action "+wV@$" in [Action::"\u{e}"];

action ":p" in [Action::"&", Action::"\u{1d}", Action::"+wV@$", Action::"\u{e}"];

