entity a;

action "" in [Action::"z~", Action::"N~\u{1f}", Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}\u{1d}@" in [Action::"$", Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "\u{e}" in [Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "\u{14}" in [Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "$" in [Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "N~\u{1f}" in [Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "[" in [Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "qqq" in [Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

action "qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq=";

action "z~" in [Action::"N~\u{1f}", Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqq", Action::"qqqqqqqqqqqqqqqq\u{1}\u{4}qqqqqqqqqqDebq="];

