entity a tags __cedar::String;

action "" in [Action::":~", Action::"\u{1d}@[", Action::"\u{3}\u{1d}w", Action::"$", Action::"=", Action::"resource\u{e}", Action::"\u{1d}\u{3}", Action::"[@[", Action::"\u{1d}@gffd~", Action::"\u{e}", Action::"^", Action::"[@", Action::"$=\u{e}", Action::"["] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
