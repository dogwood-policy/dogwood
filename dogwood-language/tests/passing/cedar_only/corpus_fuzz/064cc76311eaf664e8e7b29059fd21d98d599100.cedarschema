entity a;

action "" in [Action::":", Action::"\u{e}", Action::"[\u{1d}@", Action::"V\u{1b}e\u{16}", Action::"$"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}" in [Action::"[\u{1d}@", Action::"V\u{1b}e\u{16}", Action::"$"];

action "$";

action ":" in [Action::"\u{e}", Action::"[\u{1d}@", Action::"V\u{1b}e\u{16}", Action::"$"];

action "V\u{1b}e\u{16}" in [Action::"$"];

action "[\u{1d}@" in [Action::"V\u{1b}e\u{16}", Action::"$"];

