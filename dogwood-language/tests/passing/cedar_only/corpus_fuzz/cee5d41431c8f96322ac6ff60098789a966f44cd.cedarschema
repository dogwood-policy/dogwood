entity a;

action "" in [Action::":", Action::"\u{e}", Action::"[\u{1d}@", Action::"V", Action::"ef", Action::"$"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}" in [Action::"[\u{1d}@", Action::"V", Action::"ef", Action::"$"];

action "$";

action ":" in [Action::"\u{e}", Action::"[\u{1d}@", Action::"V", Action::"ef", Action::"$"];

action "V" in [Action::"ef", Action::"$"];

action "[\u{1d}@" in [Action::"V", Action::"ef", Action::"$"];

action "ef" in [Action::"$"];

