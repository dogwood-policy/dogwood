entity a;

action "" in [Action::"z~", Action::"N~\u{1f}", Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqqqqqqq", Action::"q"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

