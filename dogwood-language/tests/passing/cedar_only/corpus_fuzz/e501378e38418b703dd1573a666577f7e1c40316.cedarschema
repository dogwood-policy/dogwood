entity a;

action "" in [Action::":;", Action::"\u{1d}", Action::"[", Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{1d}" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":;" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V";

action "[" in [Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

