entity a;

action "" in [Action::"p", Action::"&[\u{1d}", Action::"V@"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "&[\u{1d}" in [Action::"V@"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V@" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "p" in [Action::"&[\u{1d}", Action::"V@"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

