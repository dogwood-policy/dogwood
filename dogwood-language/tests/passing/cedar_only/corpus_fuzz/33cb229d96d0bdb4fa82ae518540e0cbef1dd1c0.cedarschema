entity a;

action "" in [Action::":;", Action::"\u{1d}", Action::"[", Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{1d}" in [Action::"[", Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":;" in [Action::"\u{1d}", Action::"[", Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V" appliesTo {
  principal: [a],
  resource: [a],
  context: {
    A?: __cedar::String
  }
};

action "[" in [Action::"V"] appliesTo {
  principal: [a],
  resource: [a],
  context: {
    A?: __cedar::String
  }
};

