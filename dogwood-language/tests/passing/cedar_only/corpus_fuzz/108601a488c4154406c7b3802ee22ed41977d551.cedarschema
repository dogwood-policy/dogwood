entity a;

action "" in [Action::"&\u{3}", Action::"\u{1d}", Action::"V@", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}";

action "\u{1d}" in [Action::"V@", Action::"\u{e}"];

action "&\u{3}" in [Action::"\u{1d}", Action::"V@", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":p" in [Action::"", Action::"&\u{3}", Action::"\u{1d}", Action::"V@", Action::"\u{e}"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "V@" in [Action::"\u{e}"];

