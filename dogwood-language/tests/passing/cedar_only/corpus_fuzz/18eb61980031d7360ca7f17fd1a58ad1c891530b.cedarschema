entity a;

action "" in [Action::":", Action::"[", Action::"\u{e}\u{3}", Action::"@", Action::"e"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{e}\u{3}" in [Action::"@", Action::"e"];

action ":" in [Action::"[", Action::"\u{e}\u{3}", Action::"@", Action::"e"];

action "@" in [Action::"e"];

action "[" in [Action::"\u{e}\u{3}", Action::"@", Action::"e"];

action "e";

