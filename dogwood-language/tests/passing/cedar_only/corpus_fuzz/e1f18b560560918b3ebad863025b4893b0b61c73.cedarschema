entity a;

action "" in [Action::"z~", Action::"N~\u{1f}", Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "\u{3}\u{1d}@" in [Action::"$", Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

action "\u{e}" in [Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

action "\u{14}" in [Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

action "$" in [Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

action "N~\u{1f}" in [Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

action "[" in [Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

action "qqqqqqqqqqqqqqqqqqqqqqqqqq";

action "z~" in [Action::"N~\u{1f}", Action::"\u{e}", Action::"[", Action::"\u{3}\u{1d}@", Action::"$", Action::"\u{14}", Action::"qqqqqqqqqqqqqqqqqqqqqqqqqq"];

