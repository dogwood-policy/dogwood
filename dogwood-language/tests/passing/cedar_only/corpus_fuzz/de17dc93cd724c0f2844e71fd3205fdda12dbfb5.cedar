permit(
  principal == a::"",
  action in [Action::"action"],
  resource
) when {
  true && ((if (a::"" == a::"") then (if true then [{"": a::"", "\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": a::"", "\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": a::"", "\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}] else [{"": a::"", "\u{7}\u{7}\u{7}": a::"", "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": a::""}, {"": resource, "\u{7}\u{7}\u{7}": resource, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": principal}, {"": principal, "\u{7}\u{7}\u{7}": principal, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": action}]) else [{"": action, "\u{7}\u{7}\u{7}": resource, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": principal}, {"": principal, "\u{7}\u{7}\u{7}": principal, "\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}\u{7}": principal}]).isEmpty())
};
