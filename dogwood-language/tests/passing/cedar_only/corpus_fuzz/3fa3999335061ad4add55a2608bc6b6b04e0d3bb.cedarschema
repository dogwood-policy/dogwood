entity a;

action "" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "1" in [Action::""] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action "9" in [Action::"", Action::":"] appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

action ":" appliesTo {
  principal: [a],
  resource: [a],
  context: {}
};

