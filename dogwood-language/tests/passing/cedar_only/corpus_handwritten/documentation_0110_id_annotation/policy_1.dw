// Permit small SellShares trades, with the rule labelled
// `sell_small_only` via an `@id` annotation. The annotation
// names the rule for diagnostics and reporting; it does not
// change which requests the rule matches.

@id("sell_small_only")
permit (
    principal,
    action == Drupe::Action::"SellShares",
    resource
)
when {
    context.input.shares <= 50
};
