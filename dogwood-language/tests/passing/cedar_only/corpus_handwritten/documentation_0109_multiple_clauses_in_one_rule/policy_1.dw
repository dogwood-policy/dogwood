// Permit small trades of AMZN by combining two `when` clauses.
// Multiple Cedar clauses on a single rule are conjoined: the
// rule fires only when every clause body holds.

permit (
    principal,
    action == Drupe::Action::"SellShares",
    resource
)
when {
    context.input.shares < 100
}
when {
    context.input.stock == "AMZN"
};
