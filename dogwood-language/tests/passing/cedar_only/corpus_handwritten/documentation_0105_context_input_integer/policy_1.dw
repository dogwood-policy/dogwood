// Permit SellShares when the request stays at or below a 1000-share cap.
// New idea: `Long` is Dogwood's integer type. It supports the full
// ordered comparison set, including `<=` (used here). Compare with 0002,
// which used the strict `<`.

permit (
    principal,
    action == Drupe::Action::"SellShares",
    resource
)
when {
    context.input.shares <= 1000
};
