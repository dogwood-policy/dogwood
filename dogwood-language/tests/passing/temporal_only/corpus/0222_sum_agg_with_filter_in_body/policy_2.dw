
forbid (
    principal,
    action == Drupe::Action::"Transfer",
    resource
)
when temporal {
    exists (total: Long). ((sum a for (a: Long), (t: Timepoint). where
        ((formerly within 1h (Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a } && tp(t))) && a > 100)) == total && total > 500)};
