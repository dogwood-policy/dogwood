permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (net: Long). ((sum a for (a: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a } && tp(t)))) == net && net >= -100)};
