permit (
    principal,
    action == Drupe::Action::"Approve",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.approver }
    && formerly within 1h Drupe::Action::"Read"::request{ input.user: context.input.approver }
    && formerly within 1h Drupe::Action::"Write"::request{ input.user: context.input.approver }
};
