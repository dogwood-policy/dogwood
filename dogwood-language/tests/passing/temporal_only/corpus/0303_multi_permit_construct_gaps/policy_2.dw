permit (
    principal,
    action == Drupe::Action::"Heartbeat",
    resource
)
when temporal {
    (formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user, input.server: _ })
    && !(formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user, input.server: "banned" })
};
