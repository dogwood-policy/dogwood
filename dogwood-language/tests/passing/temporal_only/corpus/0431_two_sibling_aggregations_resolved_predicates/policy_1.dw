permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (n: Long). ((count for (t: Timepoint). where (formerly within 1h (Drupe::Action::"Login"::response{ input.user: context.input.user, output.result: true } && tp(t)))) == n && n > 1)&& exists (total: Long). ((sum r for (r: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::response{ input.user: context.input.user, output.result: r } && tp(t)))) == total && total > 100)};
