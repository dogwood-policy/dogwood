permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (n: Long). ((count for (t: Timepoint). where (formerly within 1h ((Drupe::Action::"Login"::request{ input.user: context.input.user } && !(Drupe::Action::"Login"::request{ input.user: context.input.user, input.server: "admin" })) && tp(t)))) == n && n > 1)};
