permit (
    principal,
    action == Drupe::Action::"Write",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::response{ input.user: context.input.user, output.result: true } && formerly within 1h Drupe::Action::"Read"::request{ input.user: context.input.user, input.document: context.input.document }
};
