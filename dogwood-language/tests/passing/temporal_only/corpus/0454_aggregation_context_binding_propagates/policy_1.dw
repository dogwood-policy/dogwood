permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (count: Long). ((sum a for (a: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Compute"::response{ input.user: context.input.user, input.threshold: a } && a > 100 && tp(t)))) == count && count > 0)};
