permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
unless temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user, input.server: "untrusted" }
    && formerly within 1h Drupe::Action::"Compute"::request{ input.user: context.input.user }
};
