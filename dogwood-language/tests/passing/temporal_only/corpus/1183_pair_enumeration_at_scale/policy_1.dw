// Pair enumeration stays exact as the pair space grows: three early
// anchors each pair with all four Confirms (3 x 4 = 12), and the late
// anchor at 3601 reaches only the three Confirms still inside its own
// window (@1..@3) - 15 pairs exactly, no deduplication and no cap.

permit ( principal, action == Drupe::Action::"Transfer", resource )
when temporal {
  exists (n: Long). (
    (count for (t1: Timepoint), (t2: Timepoint).
       where (formerly within 1h (
         Drupe::Action::"Transfer"::request{ input.user: context.input.user }
         && tp(t1)
         && formerly within 1h (
              Drupe::Action::"Confirm"::request{ input.user: context.input.user } && tp(t2)
            )
       ))
    ) == n && n == 15
  )
};
