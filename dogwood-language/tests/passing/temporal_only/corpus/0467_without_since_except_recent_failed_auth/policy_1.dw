permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    (!Drupe::Action::"Logout"::request{ input.user: context.input.user } since within 24h Drupe::Action::"Login"::request{ input.user: context.input.user })
    && !(formerly within 5m Drupe::Action::"FailedAuth"::request{ input.user: context.input.user })
};
