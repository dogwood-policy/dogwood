// Scope action == Read; predicate filters Login by the user STRING field
// (context.input.user), NOT by the principal entity. Trace mixes principal
// types (OAuthUser vs IamEntity) but pins user-string consistently.
// Tests whether the temporal engine joins on the user-string field rather than principal id.

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
