permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
unless temporal {
    exists (total: Long). ((sum r for (r: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Compute"::response{ input.user: context.input.user, output.result: r } && tp(t)))) == total && total > 1000)};
