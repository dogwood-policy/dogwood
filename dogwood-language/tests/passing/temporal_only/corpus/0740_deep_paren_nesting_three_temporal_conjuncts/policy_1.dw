permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    ((((formerly within 1h Drupe::Action::"Login"::request{ input.server: context.input.server })
       && (formerly within 1h Drupe::Action::"Heartbeat"::request{ input.server: context.input.server }))
      && (formerly within 1h Drupe::Action::"Transfer"::request{ input.amount: _, input.user: _ })))
};
