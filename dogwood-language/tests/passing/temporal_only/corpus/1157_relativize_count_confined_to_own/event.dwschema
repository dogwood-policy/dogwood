// Universal symmetric pin on `callerPrincipal` (both event kinds), which
// switches temporal evaluation to KEY-LOCAL (partition-safe) semantics: a
// leaf's verdict is confined to events sharing the current request's
// principal (see `event_schema::relativize`). This is the schema shape the
// partition-safety guarantee is stated against.

decision event <A>::request {
    ...inputs(A),
    pin callerPrincipal: principalType(A) = principal,
    callerResource:  resourceType(A),
    requestId:       String,
}

event <A>::response {
    ...inputs(A),
    ...outputs(A),
    pin callerPrincipal: principalType(A) = principal,
    callerResource:  resourceType(A),
    requestId:       String,
}
