permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (total: Long). ((sum a for (a: Long), (t: Timepoint). where (formerly within 1h ((Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a } && !(Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a, input.channel: "admin" })) && tp(t)))) == total && total < 1000)};
