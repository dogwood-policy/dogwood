// Inner events LATER than the outer anchor never pair with it: `formerly`
// looks backward from its anchor. Confirm@150 comes after Transfer@4, so
// the anchor at 4 contributes nothing; only the decision's own anchor at
// @3700 pairs with it - count 1, not 2. Guards the over-counting direction
// of nested-window evaluation.

permit ( principal, action == Drupe::Action::"Transfer", resource )
when temporal {
  exists (n: Long). (
    (count for (t1: Timepoint), (t2: Timepoint).
       where (formerly within 2h (
         Drupe::Action::"Transfer"::request{ input.user: context.input.user }
         && tp(t1)
         && formerly within 1h (
              Drupe::Action::"Confirm"::request{ input.user: context.input.user } && tp(t2)
            )
       ))
    ) == n && n == 1
  )
};
