// The decision event itself is a valid outer anchor whose inner window is
// measured from it: at the decision @3601 the pairs are (4, 0) - the old
// anchor with the old Confirm - and (3601, 3600) - the decision event
// pairing with the Confirm just before it. Count 2.

permit ( principal, action == Drupe::Action::"Transfer", resource )
when temporal {
  exists (n: Long). (
    (count for (t1: Timepoint), (t2: Timepoint).
       where (formerly within 1h (
         Drupe::Action::"Transfer"::request{ input.user: context.input.user }
         && tp(t1)
         && formerly within 1h (
              Drupe::Action::"Confirm"::request{ input.user: context.input.user } && tp(t2)
            )
       ))
    ) == n && n == 2
  )
};
