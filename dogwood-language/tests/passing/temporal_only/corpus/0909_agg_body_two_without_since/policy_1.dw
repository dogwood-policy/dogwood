permit (
    principal,
    action == Drupe::Action::"Transfer",
    resource
)
when temporal {
    exists (n: Long). ((count for (t: Timepoint). where ((!(Drupe::Action::"Logout"::request{ input.user: context.input.user }) since within 1h Drupe::Action::"Transfer"::request{ input.user: context.input.user }) && (!(Drupe::Action::"Logout"::request{ input.user: context.input.user }) since within 10m Drupe::Action::"Transfer"::request{ input.user: context.input.user }) && tp(t))) == n && n >= 1)};
