// Same PINNED schema as case 1117: `callerPrincipal` is pinned to the
// decision request's principal on every predicate. The difference is the
// policy (policy_1.dw), which tries to bypass the pin by binding the pinned
// field to a FRESH VARIABLE (`callerPrincipal: p`) used nowhere else — so
// the author's own constraint is vacuous (it matches any principal), an
// attempt to accept a Login by anyone. The pin is still injected
// unconditionally, so the variable cannot relax it: the past Login is forced
// to share the current Read's principal regardless.

decision event <A>::request {
    ...inputs(A),
    pin callerPrincipal: principalType(A) = principal,
    callerResource:  resourceType(A),
    requestId:       String,
}

event <A>::response {
    ...inputs(A),
    ...outputs(A),
    pin callerPrincipal: principalType(A) = principal,
    callerResource:  resourceType(A),
    requestId:       String,
}
