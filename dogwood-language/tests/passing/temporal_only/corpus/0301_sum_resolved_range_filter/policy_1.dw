forbid (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (total: Long). ((sum a for (a: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::response{ input.user: context.input.user, output.amount: a } && a > 100 && a < 500 && tp(t)))) == total && total > 1000)};
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
