permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (n: Long). ((count for (t: Timepoint). where ((!Drupe::Action::"Logout"::request{ input.user: context.input.user } since within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }) && tp(t))) == n && n > 0)};
