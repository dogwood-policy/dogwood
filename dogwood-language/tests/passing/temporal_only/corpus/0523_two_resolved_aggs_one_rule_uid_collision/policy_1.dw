forbid (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (s: Long). ((sum a for (a: Long), (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::response{ input.user: context.input.user, input.amount: a } && tp(t)))) == s && s > 800)&& exists (n: Long). ((count for (t: Timepoint). where (formerly within 1h (Drupe::Action::"Transfer"::response{ input.user: context.input.user } && tp(t)))) == n && n > 1)};
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
