permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Heartbeat"::request{ input.server: context.input.server } && exists (n: Long). ((count for (t: Timepoint). where (Drupe::Action::"Login"::request{ input.user: _, input.server: context.input.server } && tp(t))) == n && n > 2)};
