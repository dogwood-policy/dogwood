// The formerly-in-since composition with multiple inner anchors: 4 + 3 = 7
// pairs, exactly as its formerly-in-formerly and since-in-since siblings.
// The operator composition changes how each interval is delimited, not the
// pair-enumeration arithmetic.

permit ( principal, action == Drupe::Action::"Read", resource )
when temporal {
  exists (n: Long). (
    (count for (d: String), (t1: Timepoint), (t2: Timepoint).
       where (!Drupe::Action::"Login"::request{ input.user: context.input.user }
                since within 2h
              (Drupe::Action::"Read"::request{ input.user: context.input.user, input.document: d }
                 && tp(t1)
                 && formerly within 1h (
                      Drupe::Action::"Write"::request{ input.user: context.input.user, input.document: d }
                      && tp(t2)
                    ))))
    == n && n == 7
  )
};
