// Scope action filter: rule applies only to Read; trace has Login and
// Heartbeat but NO Read. No anchors -> no firings, even though the
// formerly-within Login predicate would otherwise be satisfied.

permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
