permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
    && formerly within 1h Drupe::Action::"ReadDoc"::request{ input.user: context.input.user } && !(formerly within 5m Drupe::Action::"AdminBan"::request{ input.user: context.input.user })
};
