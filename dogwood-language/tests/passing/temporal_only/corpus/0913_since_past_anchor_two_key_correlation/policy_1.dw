// Adjacent to 0904: the same past-anchor `since` shape, but the left side
// correlates on TWO current-request keys (`input.user` AND `input.region`).
//
// This guards against an implementation that threads only ONE correlation
// column through the since-anchor branch of the vacuity rewrite: a one-column
// implementation would still drop `region`, so the outer identity join would
// fail on the second key and the verdict would wrongly be false. Both keys
// must be carried. Expected verdicts are in expected_1.out.
permit (
    principal,
    action == Drupe::Action::"Transfer",
    resource
)
when temporal {
    (Drupe::Action::"Transfer"::request{
        input.user: context.input.user,
        input.region: context.input.region
     }
        && context.input.amount >= 10)
    since within 1h
    Drupe::Action::"Transfer"::request{ input.user: "carol" }
};
