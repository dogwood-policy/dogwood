permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    exists (a: Long). (
        formerly within 1h Drupe::Action::"Grant"::response{ input.user: context.input.user, output.amount: a }
        && formerly within 1h Drupe::Action::"Charge"::request{ input.user: context.input.user, input.amount: a }
    )
};
