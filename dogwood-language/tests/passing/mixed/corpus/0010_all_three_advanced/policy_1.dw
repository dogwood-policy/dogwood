// All three advanced: temporal conjunction (formerly Login AND formerly Write),
// guardrail decimal risk score, Cedar unless document starts with TEST_
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user } && formerly within 1h Drupe::Action::"Write"::request{ input.user: context.input.user }
}
when guardrails {
    Content::Risk(context.input.document).severityScore.lessThan(decimal("0.5"))
}
unless { context.input.document like "TEST_*" };
