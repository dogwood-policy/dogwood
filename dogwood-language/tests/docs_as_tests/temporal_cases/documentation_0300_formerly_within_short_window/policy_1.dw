// Write is permitted unless the user logged out within the last hour.
// The `unless temporal { ... }` block is the temporal extension marker;
// its body is the temporal sub-language.
permit (
    principal,
    action == Drupe::Action::"SellShares",
    resource
)
unless temporal {
    formerly within 1h Drupe::Action::"ApproveSale"::request{ input.stock: context.input.stock }
};
