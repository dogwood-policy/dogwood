namespace Escaped {
    entity User;
    entity Doc;
    entity Mode enum ["read", "write"];
    action "Gate" appliesTo {
        principal: [User], resource: [Doc],
        context: { input: { mode: Mode } }
    };
    action "a\"b" appliesTo {
        principal: [User], resource: [Doc],
        context: { input: { mode: Mode } }
    };
}
