// UNSOUNDNESS repro (U1a): an aggregation `for`-variable whose ONLY
// occurrence in the `where` body is under a negation. The negation
// contributes no range restriction (the range-restriction rule: the ¬ labeling rule
// discards all restriction facts; the monitorable fragment requires the
// aggregation body to denote a finite relation), so the MFOTL relation
// `{x | ¬ once Login(x)}` is INFINITE — on a trace with no logins, every
// domain value satisfies it. The evaluator cannot enumerate it; it silently
// degrades to a 0/1 witness count with no `x` column.
//
// Expected: rejected at parse-time binding checks — the `for`-variable `x`
// must be range-restricted by a positive atom in the body.
permit (principal, action == Drupe::Action::"Alert", resource)
when temporal {
    exists (nn: Long). (
        (count for (x: String). where (!(formerly within 1h Drupe::Action::"Login"::request{ input.user: x }))) == nn
        && nn >= 1
    )
};
