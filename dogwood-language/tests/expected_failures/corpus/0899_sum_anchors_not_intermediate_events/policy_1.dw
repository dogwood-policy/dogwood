permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let total = sum a where (
        without Drupe::Action::"Logout"::request{ input.user: context.input.user }
        since within 1h
        Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a }
    ) in total >= 1000
};
