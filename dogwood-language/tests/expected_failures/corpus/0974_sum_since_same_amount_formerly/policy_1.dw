permit (
    principal,
    action == Drupe::Action::"Transfer",
    resource
)
when temporal {
    let total = sum a where ((without (Drupe::Action::"Logout"::request{ input.user: context.input.user }) since within 1h Drupe::Action::"Transfer"::request{ input.user: context.input.user, input.amount: a }) && (formerly within 1h Drupe::Action::"Transfer"::request{ input.user: context.input.user })) in total >= 400
};
