namespace Drupe {
    entity OAuthUser;
    entity Gateway;
    type UserInput = { user: String };
    action Login appliesTo {
        principal: [OAuthUser],
        resource: [Gateway],
        context: { input: UserInput }
    };
    action Read appliesTo {
        principal: [OAuthUser],
        resource: [Gateway],
        context: { input: UserInput }
    };
    action Alert appliesTo {
        principal: [OAuthUser],
        resource: [Gateway],
        context: { input: UserInput }
    };
}
