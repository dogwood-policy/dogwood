permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    let n = count where (
        without Drupe::Action::"Logout"::request{ input.user: context.input.user }
        since within 1h
        Drupe::Action::"Login"::request{ input.user: context.input.user }
    ) in n >= 2
};
