// Precedence and associativity pinned by verdict: with c = 3 transfer
// requests in the window, `c + c * 2 == 9` holds only if `*` binds tighter
// than `+`, and `c - 1 + 3 == 5` holds only under left association.
permit (
    principal,
    action == Drupe::Action::"Alert",
    resource
)
when temporal {
    exists (c: Long). (
        (count for (t: Timepoint). where (
            formerly within 1h (Drupe::Action::"Transfer"::request{} && tp(t))
        )) == c
        && c + c * 2 == 9
        && c - 1 + 3 == 5
    )
};
