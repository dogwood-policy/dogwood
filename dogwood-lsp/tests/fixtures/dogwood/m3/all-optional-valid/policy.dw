// Composes the custom event, provider, and macro examples into one bundle.
@id("read_uppercase_after_login")
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when {
    is_true(Strings::Matches(context.input.document, "^[A-Z]+$").matched)
}
when temporal {
    formerly within 1h Drupe::Action::"Login"::attempt{
        input.user: context.input.user,
        actor: principal
    }
};
