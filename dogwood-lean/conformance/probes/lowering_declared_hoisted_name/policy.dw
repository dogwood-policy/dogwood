// The action schema declares `policy_0__temporal_0: Bool` in the context of `Read`, the name
// lowering gives the rule's temporal leaf. Lowering rejects it, whatever the attribute's type, as
// `PolicySet.Valid` (names fresh) does.
permit (principal, action == Drupe::Action::"Read", resource)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
