// The `Read` request context lacks the required `input.user`. The specification fails the decision
// closed (nonconforming request context); the crate fails it closed too, with the reason in its
// diagnostics.
@id("read_after_login")
permit (principal, action == Drupe::Action::"Read", resource)
when temporal {
    formerly within 1h Drupe::Action::"Login"::response{ input.user: context.input.user }
};
