// A temporal leaf reads `context.policy_0__temporal_0`, an attribute lowering adds, not one of the
// request. The specification rejects it (paths).
permit (principal, action == Drupe::Action::"Read", resource)
when temporal {
    formerly within 1h (Drupe::Action::"Login"::request{ input.user: context.input.user } && context.policy_0__temporal_0 == true)
};
