namespace Drupe {
  type LoginInput = { user: String };
  type ReadInput = { user: String, note?: String, level?: Long };
  entity Gateway;
  entity Application enum ["TinyTodo"];
  entity OAuthUser in [Application] = { id: String, level: Long } tags String;
  action "Login" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: LoginInput }
  };
  action "Read" appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: { input: ReadInput }
  };
}
