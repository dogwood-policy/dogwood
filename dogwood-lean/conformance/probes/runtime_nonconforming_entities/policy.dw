// The entity data gives `level` a `String`, where the schema declares a `Long`. The specification
// fails the decision closed (nonconforming entity store); the crate fails it closed too, with the
// reason in its diagnostics.
@id("read_after_login")
permit (principal, action == Drupe::Action::"Read", resource)
when temporal {
    formerly within 1h Drupe::Action::"Login"::response{ input.user: context.input.user }
};
