// An equality binds a `Drupe::OAuthUser` variable to `resource`, a `Drupe::Gateway`. The
// specification rejects it (comparison operands).
permit (principal, action == Drupe::Action::"Read", resource)
when temporal {
    exists (x: Drupe::OAuthUser). (
        formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user } && x == resource
    )
};
