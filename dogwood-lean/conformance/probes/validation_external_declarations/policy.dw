// The action schema declares an entity type and an action `external` (Cedar 4.14, RFC 116).
// Cedar's validator validates no policy against an incomplete schema, so both reject the rule
// (Cedar).
permit (principal, action == Drupe::Action::"Read", resource)
when temporal {
    formerly within 1h Drupe::Action::"Login"::request{ input.user: context.input.user }
};
