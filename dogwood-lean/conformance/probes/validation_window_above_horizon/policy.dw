// A read policy under an event schema that declares `max_window = 48h` with `max_horizon = 24h`:
// the window cap is longer than the horizon cap, so the crate rejects the event schema before the
// policy is checked.
@id("read_after_login_nested")
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 24h (formerly within 24h Drupe::Action::"Login"::response{ input.user: context.input.user })
};
