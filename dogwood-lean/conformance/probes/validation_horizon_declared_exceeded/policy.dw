// Two nested 24h windows (a 48h horizon), under an event schema that declares `max_horizon = 24h`:
// the crate and the specification both reject it (`horizons`).
@id("read_after_login_nested")
permit (
    principal,
    action == Drupe::Action::"Read",
    resource
)
when temporal {
    formerly within 24h (formerly within 24h Drupe::Action::"Login"::response{ input.user: context.input.user })
};
