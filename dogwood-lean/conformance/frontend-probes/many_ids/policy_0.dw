// Stable ids in two entries out of three. (entry 0)
@id("x")
permit (principal, action == Drupe::Action::"Read", resource)
when { temporal { formerly within 1h Drupe::Action::"Login"::response{ input.user: context.input.user } } };
@id("y")
forbid (principal, action == Drupe::Action::"Read", resource)
when { context.input has level && context.input.level > 3 };
